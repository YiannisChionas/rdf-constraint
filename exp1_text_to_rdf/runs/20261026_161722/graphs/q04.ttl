@prefix ent: <http://example.org/hetio/entity/> .
@prefix hetio: <http://example.org/hetio/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ent:TP53 a hetio:Gene ;
    rdfs:label "TP53" ;
    hetio:interactsWith ent:1433,
        ent:ATM,
        ent:BAX,
        ent:E2F,
        ent:GADD45,
        ent:MDM2,
        ent:P21,
        ent:TRADD .

ent:1433 a hetio:Gene ;
    rdfs:label "14-3-3" .

ent:ATM a hetio:Gene ;
    rdfs:label "ATM" .

ent:BAX a hetio:Gene ;
    rdfs:label "BAX" .

ent:E2F a hetio:Gene ;
    rdfs:label "E2F" .

ent:GADD45 a hetio:Gene ;
    rdfs:label "GADD45" .

ent:MDM2 a hetio:Gene ;
    rdfs:label "MDM2" .

ent:P21 a hetio:Gene ;
    rdfs:label "p21" .

ent:TRADD a hetio:Gene ;
    rdfs:label "TRADD" .

