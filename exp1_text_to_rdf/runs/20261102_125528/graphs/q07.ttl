@prefix ent: <http://example.org/hetio/entity/> .
@prefix hetio: <http://example.org/hetio/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ent:aliskiren a hetio:Compound ;
    rdfs:label "aliskiren" ;
    hetio:binds ent:RENIN ;
    hetio:treats ent:hypertension .

ent:amlodipine a hetio:Compound ;
    rdfs:label "amlodipine" ;
    hetio:binds ent:CALCIUM_CHANNELS ;
    hetio:treats ent:hypertension .

ent:atenolol a hetio:Compound ;
    rdfs:label "atenolol" ;
    hetio:binds ent:BETAADRENERGIC_RECEPTORS ;
    hetio:treats ent:hypertension .

ent:doxazosin a hetio:Compound ;
    rdfs:label "doxazosin" ;
    hetio:binds ent:ALPHA1_ADRENERGIC_RECEPTORS ;
    hetio:treats ent:hypertension .

ent:enalapril a hetio:Compound ;
    rdfs:label "enalapril" ;
    hetio:binds ent:ACE ;
    hetio:treats ent:hypertension .

ent:eplerenone a hetio:Compound ;
    rdfs:label "eplerenone" ;
    hetio:binds ent:MINERALOCORTICOID_RECEPTORS ;
    hetio:treats ent:hypertension .

ent:hydrochlorothiazide a hetio:Compound ;
    rdfs:label "hydrochlorothiazide" ;
    hetio:binds ent:SODIUM_CHANNELS ;
    hetio:treats ent:hypertension .

ent:lisinopril a hetio:Compound ;
    rdfs:label "lisinopril" ;
    hetio:binds ent:ACE ;
    hetio:treats ent:hypertension .

ent:losartan a hetio:Compound ;
    rdfs:label "losartan" ;
    hetio:binds ent:AT1 ;
    hetio:treats ent:hypertension .

ent:metoprolol a hetio:Compound ;
    rdfs:label "metoprolol" ;
    hetio:binds ent:BETAADRENERGIC_RECEPTORS ;
    hetio:treats ent:hypertension .

ent:spironolactone a hetio:Compound ;
    rdfs:label "spironolactone" ;
    hetio:binds ent:MINERALOCORTICOID_RECEPTORS ;
    hetio:treats ent:hypertension .

ent:valsartan a hetio:Compound ;
    rdfs:label "valsartan" ;
    hetio:binds ent:AT1 ;
    hetio:treats ent:hypertension .

ent:verapamil a hetio:Compound ;
    rdfs:label "verapamil" ;
    hetio:binds ent:CALCIUM_CHANNELS ;
    hetio:treats ent:hypertension .

ent:ALPHA1_ADRENERGIC_RECEPTORS a hetio:Gene ;
    rdfs:label "Alpha-1 adrenergic receptors" .

ent:RENIN a hetio:Gene ;
    rdfs:label "Renin" .

ent:SODIUM_CHANNELS a hetio:Gene ;
    rdfs:label "Sodium channels" .

ent:ACE a hetio:Gene ;
    rdfs:label "ACE" .

ent:AT1 a hetio:Gene ;
    rdfs:label "AT1" .

ent:BETAADRENERGIC_RECEPTORS a hetio:Gene ;
    rdfs:label "Beta-adrenergic receptors" .

ent:CALCIUM_CHANNELS a hetio:Gene ;
    rdfs:label "Calcium channels" .

ent:MINERALOCORTICOID_RECEPTORS a hetio:Gene ;
    rdfs:label "Mineralocorticoid receptors" .

ent:hypertension a hetio:Disease ;
    rdfs:label "hypertension" .

