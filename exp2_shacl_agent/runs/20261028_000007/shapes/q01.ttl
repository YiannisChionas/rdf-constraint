@prefix hetio: <http://example.org/hetio/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

hetio:CompoundShape a sh:NodeShape ;
    sh:property [ sh:class hetio:Compound ;
            sh:message "hetio:associatedWith must point from a Compound to a Compound." ;
            sh:path hetio:associatedWith ],
        [ sh:class hetio:Compound ;
            sh:message "hetio:associatedWith must point from a Compound to a Compound." ;
            sh:path hetio:associatedWith ],
        [ sh:class hetio:Compound ;
            sh:message "hetio:associatedWith must point from a Compound to a Compound." ;
            sh:path hetio:associatedWith ],
        [ sh:class hetio:Compound ;
            sh:message "hetio:associatedWith must point from a Compound to a Compound." ;
            sh:path hetio:associatedWith ] ;
    sh:targetClass hetio:Compound .

