@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix hetio: <http://example.org/hetio/> .
@prefix ent: <http://example.org/hetio/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hetio:CompoundShape
    a sh:NodeShape ;
    sh:targetClass hetio:Compound ;
    sh:property [
        sh:path hetio:treats ;
        sh:targetClass hetio:Disease ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path hetio:binds ;
        sh:targetClass hetio:Gene ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

hetio:GeneShape
    a sh:NodeShape ;
    sh:targetClass hetio:Gene ;
    sh:property [
        sh:path hetio:binds ;
        sh:targetClass hetio:Compound ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path hetio:interactsWith ;
        sh:targetClass hetio:Gene ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

hetio:DiseaseShape
    a sh:NodeShape ;
    sh:targetClass hetio:Disease ;
    sh:property [
        sh:path hetio:treats ;
        sh:targetClass hetio:Compound ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path hetio:associatedWith ;
        sh:targetClass hetio:Gene ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .