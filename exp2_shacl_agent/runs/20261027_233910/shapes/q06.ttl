@prefix sh: <http://www.w3.org/2018/shape-expressions#> .
@prefix hetio: <https://hetionet.org/ontology/hetionet/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

sh:targetClass hetio:Gene ;
  sh:property [
    sh:predicate hetio:participatesIn ;
    sh:targetClass hetio:MolecularFunction ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:predicate hetio:regulates ;
    sh:targetClass hetio:Gene ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:predicate hetio:interactsWith ;
    sh:targetClass hetio:Gene ;
    sh:minCount 1 ;
  ] .

sh:targetClass hetio:Compound ;
  sh:property [
    sh:predicate hetio:participatesIn ;
    sh:targetClass hetio:MolecularFunction ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:predicate hetio:binds ;
    sh:targetClass hetio:Gene ;
    sh:minCount 1 ;
  ] .

sh:targetClass hetio:Disease ;
  sh:property [
    sh:predicate hetio:associatedWith ;
    sh:targetClass hetio:Gene ;
    sh:minCount 1 ;
  ] .

sh:targetClass hetio:MolecularFunction ;
  sh:property [
    sh:predicate hetio:participatesIn ;
    sh:targetClass hetio:Gene ;
    sh:minCount 1 ;
  ] .

sh:targetClass hetio:Anatomy ;
  sh:property [
    sh:predicate hetio:expresses ;
    sh:targetClass hetio:Gene ;
    sh:minCount 1 ;
  ] .