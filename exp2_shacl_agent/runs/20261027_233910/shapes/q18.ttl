@prefix sh: <http://www.w3.org/2018/shape-expressions#> .
@prefix hetio: <https://hetionet.org/ontology/hetionet/> .

sh:targetClass hetio:Gene ;
  sh:property [
    sh:path hetio:interactsWith ;
    sh:domain hetio:Gene ;
    sh:range hetio:Gene ;
    sh:minCount 1 ;
    sh:maxCount 100
  ] .

sh:targetClass hetio:Gene ;
  sh:property [
    sh:path hetio:expresses ;
    sh:domain hetio:Gene ;
    sh:range hetio:Anatomy ;
    sh:minCount 1 ;
    sh:maxCount 100
  ] .

sh:targetClass hetio:Gene ;
  sh:property [
    sh:path hetio:participates ;
    sh:domain hetio:Gene ;
    sh:range hetio:MolecularFunction ;
    sh:minCount 1 ;
    sh:maxCount 100
  ] .

sh:targetClass hetio:Compound ;
  sh:property [
    sh:path hetio:causes ;
    sh:domain hetio:Compound ;
    sh:range hetio:SideEffect ;
    sh:minCount 1 ;
    sh:maxCount 100
  ] .

sh:targetClass hetio:Compound ;
  sh:property [
    sh:path hetio:resembles ;
    sh:domain hetio:Compound ;
    sh:range hetio:Compound ;
    sh:minCount 1 ;
    sh:maxCount 100
  ] .

sh:targetClass hetio:Disease ;
  sh:property [
    sh:path hetio:causes ;
    sh:domain hetio:Disease ;
    sh:range hetio:SideEffect ;
    sh:minCount 1 ;
    sh:maxCount 100
  ] .