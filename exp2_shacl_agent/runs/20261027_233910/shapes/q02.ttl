@prefix sh: <http://www.w3.org/2009/Spatial/ontologies/shacl#> .
@prefix hetio: <https://hetionet.org/ontology/hetionet/> .

sh:targetClass hetio:Gene ;
  sh:property [
    sh:predicate hetio:participatesInGpBp ;
    sh:domain hetio:Gene ;
    sh:range hetio:BiologicalProcess ;
    sh:minCount 1 ;
    sh:maxCount 25
  ] ;
  sh:property [
    sh:predicate hetio:expressesAeG ;
    sh:domain hetio:Gene ;
    sh:range hetio:Anatomy ;
    sh:minCount 1 ;
    sh:maxCount 30
  ] .

sh:targetClass hetio:Disease ;
  sh:property [
    sh:predicate hetio:downregulatesDdG ;
    sh:domain hetio:Disease ;
    sh:range hetio:Gene ;
    sh:minCount 1 ;
    sh:maxCount 25
  ] ;
  sh:property [
    sh:predicate hetio:resemblesDrD ;
    sh:domain hetio:Disease ;
    sh:range hetio:Disease ;
    sh:minCount 1 ;
    sh:maxCount 6
  ] ;
  sh:property [
    sh:predicate hetio:treatsCtD ;
    sh:domain hetio:Compound ;
    sh:range hetio:Disease ;
    sh:minCount 1 ;
    sh:maxCount 11
  ] .