@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix hetio: <https://het.io/hetio/> .

sh:NodeShape [
    sh:targetClass hetio:Gene ;
    sh:property [
        sh:predicate hetio:participates_GpMF ;
        sh:domain hetio:Gene ;
        sh:range hetio:MolecularFunction ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:predicate hetio:regulates_GrG ;
        sh:domain hetio:Gene ;
        sh:range hetio:Gene ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:predicate hetio:expresses_AeG ;
        sh:domain hetio:Anatomy ;
        sh:range hetio:Gene ;
        sh:minCount 1 ;
    ] ;
] .

sh:NodeShape [
    sh:targetClass hetio:MolecularFunction ;
    sh:property [
        sh:predicate rdf:inverseOf ;
        sh:domain hetio:Gene ;
        sh:range hetio:MolecularFunction ;
    ] ;
] .

sh:NodeShape [
    sh:targetClass hetio:Anatomy ;
    sh:property [
        sh:predicate hetio:expresses_AeG ;
        sh:domain hetio:Anatomy ;
        sh:range hetio:Gene ;
        sh:minCount 1 ;
    ] ;
] .