@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix hetio: <http://example.org/hetio/> .
@prefix ent: <http://example.org/hetio/entity/> .

sh:NodeShape (
  sh:targetClass hetio:Compound ;
  sh:property [
    sh:path hetio:treats ;
    sh:targetClass hetio:Disease ;
    sh:minCount 1 ;
    sh:maxCount 2
  ] ;
  sh:property [
    sh:path hetio:binds ;
    sh:targetClass hetio:Gene ;
    sh:minCount 1 ;
    sh:maxCount 20
  ]
) .

sh:NodeShape (
  sh:targetClass hetio:Gene ;
  sh:property [
    sh:path hetio:associatedWith ;
    sh:targetClass hetio:Disease ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path hetio:interactsWith ;
    sh:targetClass hetio:Gene ;
    sh:minCount 0 ;
    sh:maxCount 1
  ]
) .

sh:NodeShape (
  sh:targetClass hetio:Disease ;
  sh:property [
    sh:path hetio:associatedWith ;
    sh:inversePath hetio:associatedWith ;
    sh:targetClass hetio:Gene ;
    sh:minCount 0 ;
    sh:maxCount 1
  ]
) .