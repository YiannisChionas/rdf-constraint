@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix hetio: <https://het.io/hetio/> .

sh:NodeShape [
    sh:targetClass hetio:Gene ;
    sh:property [
        sh:predicate hetio:PARTICIPATES_GpMF ;
        sh:domain hetio:Gene ;
        sh:range hetio:MolecularFunction ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:predicate hetio:REGULATES_GrG ;
        sh:domain hetio:Gene ;
        sh:range hetio:Gene ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:predicate hetio:INTERACTS_GiG ;
        sh:domain hetio:Gene ;
        sh:range hetio:Gene ;
        sh:minCount 1 ;
    ] ;
] .

sh:NodeShape [
    sh:targetClass hetio:Compound ;
    sh:property [
        sh:predicate hetio:BINDS_CbG ;
        sh:domain hetio:Compound ;
        sh:range hetio:Gene ;
        sh:minCount 1 ;
    ] ;
] .

sh:NodeShape [
    sh:targetClass hetio:Disease ;
    sh:property [
        sh:predicate hetio:ASSOCIATES_DaG ;
        sh:domain hetio:Disease ;
        sh:range hetio:Gene ;
        sh:minCount 1 ;
    ] ;
] .

sh:NodeShape [
    sh:targetClass hetio:Anatomy ;
    sh:property [
        sh:predicate hetio:EXPRESSES_AeG ;
        sh:domain hetio:Anatomy ;
        sh:range hetio:Gene ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:predicate hetio:UPREGULATES_AuG ;
        sh:domain hetio:Anatomy ;
        sh:range hetio:Gene ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:predicate hetio:DOWNREGULATES_AdG ;
        sh:domain hetio:Anatomy ;
        sh:range hetio:Gene ;
        sh:minCount 1 ;
    ] ;
] .