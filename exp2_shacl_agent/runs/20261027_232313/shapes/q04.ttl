@prefix sh: <http://www.w3.org/2009/SparqlResults#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix hetio: <https://het.io/hetio/> .

sh:NodeShape [
    sh:targetClass hetio:Gene ;
    sh:hasValue [
        sh:property [
            sh:predicate hetio:participatesIn ;
            sh:targetClass hetio:MolecularFunction ;
            sh:minCount 1 ;
            sh:maxCount 10
        ]
    ] ;
    sh:hasValue [
        sh:property [
            sh:predicate hetio:regulates ;
            sh:targetClass hetio:Gene ;
            sh:minCount 1 ;
            sh:maxCount 20
        ]
    ] ;
    sh:hasValue [
        sh:property [
            sh:predicate hetio:expresses ;
            sh:targetClass hetio:Anatomy ;
            sh:minCount 1 ;
            sh:maxCount 25
        ]
    ]
] .

sh:NodeShape [
    sh:targetClass hetio:MolecularFunction ;
    sh:hasValue [
        sh:property [
            sh:predicate rdf:type ;
            sh:targetClass hetio:MolecularFunction ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ]
] .

sh:NodeShape [
    sh:targetClass hetio:Anatomy ;
    sh:hasValue [
        sh:property [
            sh:predicate hetio:expresses ;
            sh:targetClass hetio:Gene ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ]
] .

sh:NodeShape [
    sh:targetClass hetio:Gene ;
    sh:hasValue [
        sh:property [
            sh:predicate hetio:interactsWith ;
            sh:targetClass hetio:Gene ;
            sh:minCount 1 ;
            sh:maxCount 2
        ]
    ]
] .