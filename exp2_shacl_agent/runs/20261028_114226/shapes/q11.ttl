@prefix hetio: <http://example.org/hetio/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hetio:DiseaseShape a sh:NodeShape ;
    sh:property [ sh:maxCount 0 ;
            sh:message "A Disease is never the subject of hetio:treats." ;
            sh:path hetio:treats ],
        [ sh:class hetio:Disease ;
            sh:message "hetio:associatedWith must point from a Disease to a Disease." ;
            sh:path hetio:associatedWith ] ;
    sh:targetClass hetio:Disease .

hetio:GeneShape a sh:NodeShape ;
    sh:property [ sh:maxCount 0 ;
            sh:message "A Gene is never the subject of hetio:binds." ;
            sh:path hetio:binds ],
        [ sh:class hetio:Gene ;
            sh:message "hetio:interactsWith must point from a Gene to a Gene." ;
            sh:path hetio:interactsWith ] ;
    sh:targetClass hetio:Gene .

