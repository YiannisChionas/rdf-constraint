@prefix sh: <http://www.w3.org/2009/SparqlResults#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix hetio: <https://het.io/hetionet/> .

sh:NodeShape [
    sh:targetClass hetio:Compound ;
    sh:property [
        sh:predicate hetio:causes_ccse ;
        sh:domain hetio:Compound ;
        sh:range hetio:SideEffect ;
        sh:minCount 1 ;
        sh:maxCount 25
    ]
] .

sh:NodeShape [
    sh:targetClass hetio:PharmacologicClass ;
    sh:property [
        sh:predicate hetio:includes_pci_c ;
        sh:domain hetio:PharmacologicClass ;
        sh:range hetio:Compound ;
        sh:minCount 1 ;
        sh:maxCount 5
    ]
] .

sh:NodeShape [
    sh:targetClass hetio:SideEffect ;
    sh:property [
        sh:predicate rdf:inverseOf hetio:causes_ccse ;
        sh:domain hetio:SideEffect ;
        sh:range hetio:Compound ;
        sh:minCount 1 ;
        sh:maxCount 25
    ]
] .