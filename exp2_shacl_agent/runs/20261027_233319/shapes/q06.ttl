@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix hetio: <https://het.io/hetio/> .

sh:NodeShape [
  a sh:NodeShape ;
  sh:targetClass hetio:Gene ;
  sh:property [
    a sh:PropertyShape ;
    sh:path hetio:participatesInMolecularFunction ;
    sh:domain hetio:Gene ;
    sh:range hetio:MolecularFunction ;
    sh:minCount 1 ;
    sh:maxCount 10
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path hetio:regulatesGene ;
    sh:domain hetio:Gene ;
    sh:range hetio:Gene ;
    sh:minCount 1 ;
    sh:maxCount 25
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:path hetio:interactsWithGene ;
    sh:domain hetio:Gene ;
    sh:range hetio:Gene ;
    sh:minCount 1 ;
    sh:maxCount 25
  ]
] .

sh:NodeShape [
  a sh:NodeShape ;
  sh:targetClass hetio:Anatomy ;
  sh:property [
    a sh:PropertyShape ;
    sh:path hetio:expressesGene ;
    sh:domain hetio:Anatomy ;
    sh:range hetio:Gene ;
    sh:minCount 1 ;
    sh:maxCount 25
  ]
] .