@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix hetio: <http://example.org/hetio/> .
@prefix ent: <http://example.org/hetio/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hetio:CompoundShape
    a sh:NodeShape ;
    sh:targetClass hetio:Compound ;
    sh:property [
        sh:path hetio:treats ;
        sh:class hetio:Disease ;
        sh:message "hetio:treats must point from a Compound to a Disease." ;
    ] ;
    sh:property [
        sh:path hetio:binds ;
        sh:class hetio:Gene ;
        sh:message "hetio:binds must point from a Compound to a Gene." ;
    ] .

hetio:DiseaseShape
    a sh:NodeShape ;
    sh:targetClass hetio:Disease ;
    sh:property [
        sh:path hetio:treatedBy ;
        sh:class hetio:Compound ;
        sh:message "hetio:treatedBy must point from a Disease to a Compound." ;
    ] .

hetio:GeneShape
    a sh:NodeShape ;
    sh:targetClass hetio:Gene ;
    sh:property [
        sh:path hetio:regulatedBy ;
        sh:class hetio:Gene ;
        sh:message "hetio:regulatedBy must point from a Gene to a Gene." ;
    ] ;
    sh:property [
        sh:path hetio:bindsTo ;
        sh:class hetio:Gene ;
        sh:message "hetio:bindsTo must point from a Gene to a Gene." ;
    ] ;
    sh:property [
        sh:path hetio:participatesIn ;
        sh:class hetio:MolecularFunction ;
        sh:message "hetio:participatesIn must point from a Gene to a MolecularFunction." ;
    ] ;
    sh:property [
        sh:path hetio:expressedIn ;
        sh:class hetio:Anatomy ;
        sh:message "hetio:expressedIn must point from a Gene to an Anatomy." ;
    ] .